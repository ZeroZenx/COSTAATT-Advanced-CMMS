// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  TECHNICIAN
  REQUESTOR
}

enum Status {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionType {
  IN
  OUT
  ADJUST
}

enum WorkType {
  INTERNAL
  CONTRACTOR
  MIXED
}

enum OriginationSource {
  CUSTOMER_REQUEST
  INSPECTION_ROUNDS
  PREVENTIVE_MAINTENANCE
  EMERGENCY
}

enum WorkflowPhaseType {
  ORIGINATION
  PLANNING
  SCHEDULING
  EXECUTION
  FEEDBACK
  EVALUATION
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AssignmentType {
  PRIMARY
  BACKUP
  SPECIALIST
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum POStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ExecutionStatus {
  STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum DocumentType {
  ESTIMATE
  QUOTATION
  INVOICE
  DELIVERY_NOTE
  CERTIFICATE
  REPORT
  OTHER
}

enum ReportType {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum MaintenanceStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(REQUESTOR)
  department   String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdWorkOrders WorkOrder[] @relation("CreatedBy")
  assignedWorkOrders WorkOrder[] @relation("AssignedTo")
  comments          Comment[]
  
  // New module relations
  maintenanceAssignedTo MaintenanceSchedule[] @relation("MaintenanceAssignedTo")
  maintenanceCompletedBy MaintenanceTask[] @relation("MaintenanceCompletedBy")
  inventoryPerformedBy InventoryTransaction[] @relation("InventoryPerformedBy")
  
  // Notification relations
  notifications       Notification[]
  notificationPreferences NotificationPreferences?
  pushTokens          PushToken[]
  
  // Vendor performance relations
  vendorPerformance   VendorPerformance[]

  // Campus Services Work Process relations
  workExecutedBy      WorkExecutionLog[] @relation("WorkExecutedBy")
  qualityCheckedBy    WorkQualityCheck[] @relation("QualityCheckedBy")
  documentUploadedBy  WorkflowDocument[] @relation("DocumentUploadedBy")
  reportGeneratedBy   PerformanceReport[] @relation("ReportGeneratedBy")
  poApprovedBy       PurchaseOrder[] @relation("POApprovedBy")

  @@map("users")
}

model WorkOrder {
  id          String   @id @default(cuid())
  title       String
  description String
  status      Status   @default(OPEN)
  priority    Priority @default(MEDIUM)
  location    String
  category    String
  createdById String
  assignedToId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dueDate     DateTime?
  completedAt DateTime?

  // Campus Services Work Process fields
  workType            WorkType?   @default(INTERNAL)
  originationSource   OriginationSource? @default(CUSTOMER_REQUEST)
  canPerformInternally Boolean?   @default(true)
  requiresContractor  Boolean?   @default(false)
  estimatedCost       Decimal?   @db.Decimal(10, 2)
  estimatedDuration   Int?       // in hours
  workOrderNumber     String?    @unique

  // Relations
  createdBy   User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo  User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  comments    Comment[]
  attachments Attachment[]
  
  // New module relations
  maintenanceTasks MaintenanceTask[]
  inventoryTransactions InventoryTransaction[]
  slaEvents       SLAEvent[]
  
  // Notification relations
  notifications     Notification[]
  
  // Workflow relations
  workflowExecutions WorkflowExecution[]
  
  // Vendor performance relations
  vendorPerformance VendorPerformance[]

  // Campus Services Work Process relations
  workflowPhases         WorkflowPhase[]
  contractorAssignments  ContractorAssignment[]
  purchaseOrders         PurchaseOrder[]
  workExecutionLogs      WorkExecutionLog[]
  workQualityChecks      WorkQualityCheck[]
  performanceMetrics      PerformanceMetric[]
  workflowDocuments      WorkflowDocument[]

  @@map("work_orders")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  building    String?
  floor       String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("locations")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  isInternal  Boolean  @default(false)
  workOrderId String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model Attachment {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  workOrderId String
  uploadedBy  String
  createdAt   DateTime @default(now())

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// === PREVENTIVE MAINTENANCE MODULE ===
model MaintenanceSchedule {
  id              String            @id @default(cuid())
  title           String
  description     String?
  assetId         String
  frequency       Frequency
  nextDueDate     DateTime
  lastCompletedDate DateTime?
  assignedToId    String?
  status          MaintenanceStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  assignedTo      User?             @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])
  tasks           MaintenanceTask[]

  @@map("maintenance_schedules")
}

model MaintenanceTask {
  id              String   @id @default(cuid())
  scheduleId      String
  workOrderId     String?
  performedAt     DateTime?
  notes           String?
  completedById   String?
  createdAt       DateTime @default(now())

  // Relations
  schedule        MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?          @relation(fields: [workOrderId], references: [id])
  completedBy     User?               @relation("MaintenanceCompletedBy", fields: [completedById], references: [id])

  @@map("maintenance_tasks")
}

// === INVENTORY MANAGEMENT MODULE ===
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String
  quantity      Int      @default(0)
  reorderLevel  Int      @default(0)
  unitCost      Decimal  @default(0) @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  transactions  InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  itemId        String
  workOrderId   String?
  type          TransactionType
  quantity      Int
  performedById String
  notes         String?
  createdAt     DateTime        @default(now())

  // Relations
  item          InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder?      @relation(fields: [workOrderId], references: [id])
  performedBy   User            @relation("InventoryPerformedBy", fields: [performedById], references: [id])

  @@map("inventory_transactions")
}

// === SLA & AUTOMATION MODULE ===
model SLAEvent {
  id            String    @id @default(cuid())
  workOrderId   String
  targetAt      DateTime
  breached      Boolean   @default(false)
  resolvedAt    DateTime?
  escalated     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("sla_events")
}

// === NOTIFICATION SYSTEM MODULE ===
model Notification {
  id          String   @id @default(cuid())
  userId      String
  workOrderId String?
  type        String
  priority    String
  subject     String
  body        String
  data        Json?
  sentAt      DateTime @default(now())
  readAt      DateTime?
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  push      Boolean  @default(true)
  webhook   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// === WORKFLOW AUTOMATION MODULE ===
model WorkflowRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  trigger     String   // work_order_created, work_order_updated, etc.
  conditions  Json     // Rule conditions
  actions     Json     // Actions to take
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  executions  WorkflowExecution[]

  @@map("workflow_rules")
}

model WorkflowExecution {
  id          String   @id @default(cuid())
  ruleId      String
  workOrderId String?
  status      String   // pending, running, completed, failed
  result      Json?
  executedAt  DateTime @default(now())
  completedAt DateTime?

  // Relations
  rule        WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

// === VENDOR MANAGEMENT MODULE ===
model Vendor {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  address     String?
  contactPerson String?
  rating      Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contracts   Contract[]
  performance VendorPerformance[]
  assignments ContractorAssignment[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model Contract {
  id          String   @id @default(cuid())
  vendorId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  value       Decimal  @db.Decimal(10, 2)
  status      String   // active, expired, terminated
  terms       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model VendorPerformance {
  id          String   @id @default(cuid())
  vendorId    String
  workOrderId String?
  userId      String
  rating      Int      // 1-5
  responseTime Int?    // in hours
  quality     Int?     // 1-5
  cost        Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  vendor      Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendor_performance")
}

// === CAMPUS SERVICES WORK PROCESS MODULE ===
model WorkflowPhase {
  id          String   @id @default(cuid())
  workOrderId String
  phase       WorkflowPhaseType
  status      PhaseStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, phase])
  @@map("workflow_phases")
}

model ContractorAssignment {
  id                    String           @id @default(cuid())
  workOrderId           String
  vendorId              String
  assignmentType        AssignmentType   @default(PRIMARY)
  estimatedCost         Decimal?         @db.Decimal(10, 2)
  estimatedDurationHours Int?
  assignedAt            DateTime         @default(now())
  status                AssignmentStatus @default(PENDING)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  workOrder             WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendor                Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("contractor_assignments")
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  workOrderId String
  vendorId    String
  poNumber    String   @unique
  status      POStatus @default(DRAFT)
  totalAmount Decimal  @db.Decimal(10, 2)
  currency    String   @default("TTD")
  issuedDate  DateTime?
  dueDate     DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  terms       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  approvedByUser User?  @relation("POApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemName        String
  description     String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  // Relations
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model WorkExecutionLog {
  id                String          @id @default(cuid())
  workOrderId       String
  executedById      String
  executionType     String          // INTERNAL or CONTRACTOR
  startTime         DateTime?
  endTime           DateTime?
  hoursWorked       Decimal?        @db.Decimal(5, 2)
  materialsUsed     String?
  issuesEncountered String?
  progressNotes     String?
  status            ExecutionStatus @default(STARTED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  workOrder         WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  executedBy        User            @relation("WorkExecutedBy", fields: [executedById], references: [id], onDelete: Cascade)

  @@map("work_execution_logs")
}

model WorkQualityCheck {
  id                      String   @id @default(cuid())
  workOrderId             String
  checkedById             String
  qualityRating           Int      // 1-5
  timePerformanceRating   Int      // 1-5
  costPerformanceRating   Int      // 1-5
  complianceCheck         Boolean  @default(false)
  safetyCheck             Boolean  @default(false)
  customerSatisfaction    Int      // 1-5
  issuesFound             String?
  correctiveActions       String?
  approvedForClosure      Boolean  @default(false)
  checkedAt               DateTime @default(now())

  // Relations
  workOrder               WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checkedBy               User      @relation("QualityCheckedBy", fields: [checkedById], references: [id], onDelete: Cascade)

  @@map("work_quality_checks")
}

model PerformanceMetric {
  id            String   @id @default(cuid())
  workOrderId   String
  metricType    String   // TURNAROUND_TIME, COST_EFFICIENCY, QUALITY_SCORE, etc.
  metricValue   Decimal  @db.Decimal(10, 2)
  targetValue   Decimal? @db.Decimal(10, 2)
  unit          String?
  calculatedAt  DateTime @default(now())

  // Relations
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("performance_metrics")
}

model WorkflowDocument {
  id            String       @id @default(cuid())
  workOrderId   String
  phase         WorkflowPhaseType
  documentType  DocumentType
  filename      String
  originalName  String
  filePath      String
  fileSize      Int
  mimeType      String?
  uploadedBy    String
  uploadedAt    DateTime     @default(now())

  // Relations
  workOrder     WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedByUser User        @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("workflow_documents")
}

model PerformanceReport {
  id            String     @id @default(cuid())
  reportType    ReportType
  periodStart   DateTime
  periodEnd     DateTime
  generatedBy   String
  reportData    Json?
  filePath      String?
  generatedAt   DateTime   @default(now())

  // Relations
  generatedByUser User     @relation("ReportGeneratedBy", fields: [generatedBy], references: [id], onDelete: Cascade)

  @@map("performance_reports")
}

// === ENERGY MANAGEMENT MODULE ===
model EnergyConsumption {
  id          String   @id @default(cuid())
  assetId     String
  location    String
  consumption Float
  unit        String   // kWh, BTU, etc.
  cost        Decimal? @db.Decimal(10, 2)
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("energy_consumption")
}

model SustainabilityReport {
  id          String   @id @default(cuid())
  period      String   // monthly, quarterly, yearly
  year        Int
  month       Int?
  quarter     Int?
  totalEnergy Float
  totalCost   Decimal  @db.Decimal(10, 2)
  carbonFootprint Float?
  reportData  Json
  createdAt   DateTime @default(now())

  @@map("sustainability_reports")
}

// === IOT SENSOR MODULE ===
model Sensor {
  id          String   @id @default(cuid())
  name        String
  type        String   // temperature, vibration, pressure, etc.
  location    String
  assetId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  readings    SensorReading[]

  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  value     Float
  unit      String
  timestamp DateTime @default(now())
  metadata  Json?

  // Relations
  sensor    Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("sensor_readings")
}

// === AI PREDICTIVE MAINTENANCE MODULE ===
model PredictionModel {
  id          String   @id @default(cuid())
  name        String
  type        String   // failure_prediction, maintenance_scheduling, etc.
  modelData   Json     // Serialized model
  accuracy    Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  predictions Prediction[]

  @@map("prediction_models")
}

model Prediction {
  id          String   @id @default(cuid())
  modelId     String
  assetId     String
  prediction  Json     // Prediction results
  confidence  Float
  createdAt   DateTime @default(now())

  // Relations
  model       PredictionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("predictions")
}

// === BLOCKCHAIN COMPLIANCE MODULE ===
model AuditTrail {
  id          String   @id @default(cuid())
  entityType  String   // work_order, maintenance_task, etc.
  entityId    String
  action      String   // created, updated, deleted, etc.
  changes     Json
  hash        String   // Blockchain hash
  blockNumber String?
  createdAt   DateTime @default(now())

  @@map("audit_trails")
}

// Update existing models with new relations
